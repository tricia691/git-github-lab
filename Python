# =====================================================================
# FIXED PART (everything above is unchanged except Shrek -> Rihanna)
#
# Why it crashed: By.LINK_TEXT only matches *visible* text. The
# "Mobiles" / "Laptops" links live inside a dropdown that is display:none
# until the mouse hovers 'dropbtn'. After the popup windows were closed the
# hover was lost, so Selenium saw no visible "Mobiles" link and raised
# NoSuchElementException. XPath matches the DOM text even when hidden, and
# a JS click works on hidden / covered elements.
# =====================================================================
BASE_URL = "https://testautomationpractice.blogspot.com/"


def hover(el):
    try:
        ActionChains(driver).move_to_element(el).perform()
    except Exception as e:
        print("  (hover skipped:", type(e).__name__, ")")
    time.sleep(0.5)


def safe_click(el):
    try:
        el.click()
    except Exception:
        driver.execute_script("arguments[0].scrollIntoView({block:'center'});", el)
        driver.execute_script("arguments[0].click();", el)


def link_by_text(text):
    return driver.find_element(By.XPATH, f"//a[normalize-space(.)='{text}']")


def back_to_main():
    """Close any extra tabs/popups and return to the main window + page."""
    main = driver.window_handles[0]
    for handle in driver.window_handles[1:]:
        driver.switch_to.window(handle)
        driver.close()
    driver.switch_to.window(main)
    if "testautomationpractice.blogspot.com" not in driver.current_url:
        driver.get(BASE_URL)
        time.sleep(1)


def open_and_return(el):
    """Click a link, wait, then come back to the practice page."""
    hover(el)
    safe_click(el)
    time.sleep(2)
    if len(driver.window_handles) > 1:
        back_to_main()
    else:
        driver.back()
        time.sleep(1)
        back_to_main()


def run(label, fn):
    """Run one section; if it fails, report it and keep going to the end."""
    print("Running:", label)
    try:
        fn()
    except Exception as e:
        print(f"  !! {label} failed: {type(e).__name__}: {str(e).splitlines()[0]}")
        try:
            back_to_main()
        except Exception:
            pass


def section_dropdown():
    dropbtn = driver.find_element(By.CLASS_NAME, 'dropbtn')
    hover(dropbtn)
    time.sleep(0.5)
    mobiles_link = link_by_text('Mobiles')
    hover(mobiles_link)
    laptops_link = link_by_text('Laptops')
    hover(laptops_link)
    safe_click(laptops_link)
    time.sleep(0.5)


