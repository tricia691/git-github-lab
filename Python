    time.sleep(0.5)
    safe_click(shadow_root.find_element(By.CSS_SELECTOR, 'input[type="checkbox"]'))
    time.sleep(0.5)
    try:
        shadow_root.find_element(By.CSS_SELECTOR, 'input[type="file"]').send_keys(
            r"C:\Users\UCSOUTH\Documents\picture")
    except Exception as e:
        print("  (shadow file upload skipped:", type(e).__name__, ")")
    time.sleep(0.5)
    try:
        hover(shadow_root.find_element(By.CSS_SELECTOR, 'a'))
    except Exception as e:
        print("  (shadow link hover skipped:", type(e).__name__, ")")
    try:
        nested = shadow_root.find_element(By.CSS_SELECTOR, '#nested_shadow_host').shadow_root
        print(nested.find_element(By.CSS_SELECTOR, '#nested_shadow_content').text)
    except Exception as e:
        print("  (nested shadow skipped:", type(e).__name__, ")")
    time.sleep(1)


